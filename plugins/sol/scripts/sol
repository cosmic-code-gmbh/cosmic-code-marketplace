#!/usr/bin/env bash
# Run one GPT Sol review turn through the local Codex CLI (Codex subscription): reads the
# repo, writes only into its own scratch dir (so it can run tests), never into the repo.
# Used by the sol-loop, sol-plan and council skills of this plugin. Brief comes from stdin.
#
#   scripts/sol -C <repo> < brief.txt                 # round 1: new Codex thread
#   scripts/sol -C <repo> --resume <thread> < next.txt # later rounds: same thread
#
# Prints SOL_THREAD=<id>, SOL_USAGE=<json>, then Sol's final message.
set -euo pipefail

repo="$PWD" resume="" effort="${SOL_EFFORT:-high}" model="${SOL_MODEL:-}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    -C) repo="$2"; shift 2 ;;
    --resume) resume="$2"; shift 2 ;;
    --effort) effort="$2"; shift 2 ;;
    --model) model="$2"; shift 2 ;;
    *) echo "sol: unknown arg $1" >&2; exit 2 ;;
  esac
done

out="$(mktemp -t sol)" events="$(mktemp -t sol-events)"
# Sol's only writable place: the sandbox's working dir. TMPDIR points into it so
# test runners (vitest, tsc --incremental) can create their temp files. The repo
# is readable but neither the working dir nor an added dir, so it stays unwritable.
work="$(mktemp -d -t sol-work)"
trap 'rm -rf "$out" "$events" "$work"' EXIT
repo="$(cd "$repo" && pwd)"

args=(--json -o "$out" -c "model_reasoning_effort=\"$effort\"" -c 'sandbox_mode="workspace-write"' --skip-git-repo-check)
[[ -n "$model" ]] && args+=(-m "$model")

brief() {
  echo "Repository (read-only for you): $repo — run commands there with \`cd $repo && …\`. Writable scratch: $work (TMPDIR)."
  echo "Tests work: vitest with \`--configLoader runner\`, tsc with \`--incremental false\` (anything else writing into the repo fails)."
  echo
  cat
}

cd "$work"
export TMPDIR="$work"
if [[ -n "$resume" ]]; then
  brief | codex exec resume "$resume" "${args[@]}" - >"$events"
else
  brief | codex exec "${args[@]}" - >"$events"
fi

thread="$(grep -o '"thread_id":"[^"]*"' "$events" | head -1 | cut -d'"' -f4)"
echo "SOL_THREAD=${thread:-$resume}"
echo "SOL_USAGE=$(grep '"turn.completed"' "$events" | tail -1 | grep -o '"usage":{[^}]*}' || true)"
echo
cat "$out"
